{
  "name": "cs-bots",
  "version": "0.9.4",
  "type": "module",
  "description": "跨团队桥 + 定向唤醒 + 升级可回滚。",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "docs",
    "CHANGELOG.md",
    "cordis.patch.yml",
    "cordis.patch.agent-team.yml",
    "install.sh",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "test": "bash test/run-all.sh",
    "ci": "bash test/ci-zero-dep.sh",
    "install:check": "bash install.sh --check-only"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "multi-agent",
    "agents",
    "agent-teams",
    "task-board",
    "collaboration"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/7358716/cs-bots.git"
  },
  "homepage": "https://github.com/7358716/cs-bots#readme",
  "bugs": {
    "url": "https://github.com/7358716/cs-bots/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  }
}
